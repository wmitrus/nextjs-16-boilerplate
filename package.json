    "tenancy-inventory:scan:dev": "pnpm tenancy-inventory -- scan --target=dev",
    "tenancy-inventory:scan:test": "pnpm tenancy-inventory -- scan --target=test",
    "vercel": "node --import tsx scripts/vercel/cli.ts",
    "vercel:deploy:validate": "tsx scripts/validate-vercel-deploy-profiles.ts",
    "vercel:deploy:diagnose": "tsx scripts/vercel/diagnose-deploy-failure.ts",
    "vercel:prebuilt:validate": "tsx scripts/validate-vercel-prebuilt-artifact.ts",
    "vercel:runtime:smoke": "playwright test --config playwright.vercel-smoke.config.ts",
    "vercel:whoami": "node --import tsx scripts/vercel/cli.ts whoami",
    "vercel:inspect:logs": "node --import tsx scripts/vercel/cli.ts inspect-logs",
    "vercel:inspect:logs:wait": "node --import tsx scripts/vercel/cli.ts inspect-logs --wait",
    "lt": "node --env-file-if-exists=.env.leantime --import tsx scripts/leantime/cli.ts",
    "lt:dev": "node --env-file-if-exists=.env.leantime-dev --import tsx scripts/leantime/cli.ts",
