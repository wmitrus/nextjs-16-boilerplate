# Local-only Linear API access for the inbox-to-Linear reconciliation workflow
# (OZI-27/OZI-28/OZI-36). Copy to `.env.linear` in the repo root (never here)
# and keep that copy out of Git — same convention as `scripts/neon/neon.env.example`
# + root `.env.neon`: the example template lives with the tool that owns it,
# the real secret file loads from root via `--env-file-if-exists`.
#
# This is a personal Linear API key (Linear → Settings → API → Personal API
# keys), independent of the Claude Code `linear-server` MCP connection: that
# MCP endpoint is bound to this session's own OAuth and cannot be dialed into
# by a separately spawned script. See scripts/ai-tooling/lib/linear-api-adapter.ts.
#
# Scope: Linear personal API keys are account-wide — there is no per-project
# scoping in Linear's product. Give the key a distinct, identifiable label
# when creating it (e.g. "nextjs-16-boilerplate inbox reconciliation") so it
# can be revoked/rotated independently of any other integration. Treat it
# like any other repo-adjacent secret: never log it, never echo it to a
# terminal, never paste it into an issue/comment/document.
#
# Rotation: regenerate the key in Linear's UI, replace the value in the
# local `.env.linear` copy — no code change needed, it is read from the
# environment at process start. Rotate immediately if exposure is suspected.

LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=

# Path to the canonical, off-repo inbox capture file (OZI-27). Never point
# this at a tracked repo path. A leading "~/" is expanded to the current
# account's home directory by the loader (config.ts) — Node's --env-file
# does NOT do this itself, a literal "~/..." value stays literal otherwise.
# Example: AI_INBOX_PATH=~/.linear/inbox/capture.md
AI_INBOX_PATH=

# Optional: override where the local reconciliation ledger/lock live.
# Defaults to ~/.local/state/ai-inbox-reconcile — local-only, outside git and
# outside the (possibly synced) inbox directory. Same "~/" expansion applies.
# Example: AI_INBOX_LEDGER_DIR=~/.linear/reconcile
AI_INBOX_LEDGER_DIR=
