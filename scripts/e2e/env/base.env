# Shared base for all E2E scenario runs.

AUTH_PROVIDER=clerk

DB_PROVIDER=drizzle
DB_DRIVER=pglite

E2E_ENABLED=true
NEXT_PUBLIC_E2E_ENABLED=true

# Runtime configuration a *production* build validates at startup.
#
# CI runs the scenarios against `next start` (NODE_ENV=production), where two
# cross-field env rules fail the composition root outright if unset -- and the
# only reason local runs never noticed is that a developer's `.env.local`
# happens to supply both. A fresh clone (which is what CI is) has no
# `.env.local`, so the app answered every request with the SEC-45 error
# boundary's 500 instead of running the suite.
#
# Pinned here rather than in a workflow file: the scenario baseline is where
# "what the app under test needs to boot" belongs, and it keeps a fresh clone
# runnable without anyone's private env file.

# SEC-43: production must declare its ingress. The E2E origin is localhost
# with nothing in front of it, and `none` trusts no forwarding header at all --
# which is both the truth here and the safe direction.
DEPLOYMENT_PROXY=none

# Required in production when AUTH_PROVIDER=authjs. A fixture value,
# deliberately shaped so it cannot be mistaken for a real secret; the E2E
# origin issues sessions only to E2E fixture accounts.
NEXTAUTH_SECRET=e2e-fixture-nextauth-secret-not-a-real-secret

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/bootstrap/start?redirect_url=/users
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/bootstrap/start?redirect_url=/users
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/auth/bootstrap/start?redirect_url=/users
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/auth/bootstrap/start?redirect_url=/users

FREE_TIER_MAX_USERS=5
CROSS_PROVIDER_EMAIL_LINKING=verified-only
REGISTRATION_MODE=open
