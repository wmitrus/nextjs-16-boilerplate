# OZI-79 `RemoteTarget` credentials (scripts/tenancy-inventory/readonly-db-remote.ts).
# Never expose these to Next.js -- they are standalone script-only, not part
# of src/core/env.ts/.env.example, and are not read by the application.
#
# Not required for local/dev/test: readonly-db.ts's LocalTarget uses fixed
# local constants instead (scripts/lib/db-guard.mjs). These are required only
# to run `tenancy-inventory plan --target=staging|production
# --execute-remote-explain` (OZI-79 Phase B2) against a real target -- see
# that command's doc comment in cli.ts for its full fail-closed boundary.
#
# Each *_READONLY_DATABASE_URL value must be a SELECT-only role's
# postgres:// or postgresql:// URL (verified live by verifyReadOnlyRole --
# superuser, any write grant, any grant outside the required table set, or
# any role membership is rejected). The connection additionally requires
# certificate-validated TLS (ssl: 'verify-full', enforced in code
# regardless of what the URL says).
OZI79_STAGING_READONLY_DATABASE_URL=
OZI79_PRODUCTION_READONLY_DATABASE_URL=

# Each *_EXPECTED_DESCRIPTOR value is a SEPARATE, independently-set
# safeguard against the corresponding *_READONLY_DATABASE_URL above being
# swapped or misconfigured (e.g. staging's variable accidentally pointed
# at the production host) -- it is not derived from that URL. Must equal
# exactly what describeRemoteTarget resolves for that target:
# "<hostname>:<port>/<database>", e.g.
# "staging-db.internal:5432/app_staging". `plan` refuses to connect if
# this is unset or does not match.
OZI79_STAGING_EXPECTED_DESCRIPTOR=
OZI79_PRODUCTION_EXPECTED_DESCRIPTOR=
