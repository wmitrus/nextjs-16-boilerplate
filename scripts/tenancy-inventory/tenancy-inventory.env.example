# OZI-79 `RemoteTarget` credentials (scripts/tenancy-inventory/readonly-db-remote.ts).
# Never expose these to Next.js -- they are standalone script-only, not part
# of src/core/env.ts/.env.example, and are not read by the application.
#
# Not required for local/dev/test: readonly-db.ts's LocalTarget uses fixed
# local constants instead (scripts/lib/db-guard.mjs). These are required only
# to run the RemoteTarget plumbing against a real staging/production target,
# which is not authorized/wired into any CLI command yet (see OZI-79).
#
# Each value must be a SELECT-only role's postgres:// or postgresql:// URL
# (verified live by verifyReadOnlyRole -- superuser, any write grant, any
# grant outside the required table set, or any role membership is rejected).
# The connection additionally requires certificate-validated TLS
# (ssl: 'verify-full', enforced in code regardless of what the URL says).
OZI79_STAGING_READONLY_DATABASE_URL=
OZI79_PRODUCTION_READONLY_DATABASE_URL=
