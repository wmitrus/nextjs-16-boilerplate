# OZI-79 `RemoteTarget` credentials (scripts/tenancy-inventory/readonly-db-remote.ts).
# Never expose these to Next.js -- they are standalone script-only, not part
# of src/core/env.ts/.env.example, and are not read by the application.
#
# Not required for local/dev/test: readonly-db.ts's LocalTarget uses fixed
# local constants instead (scripts/lib/db-guard.mjs). These are required only
# to run `tenancy-inventory plan --target=staging|production
# --execute-remote-explain` (OZI-79 Phase B2) against a real target -- see
# that command's doc comment in cli.ts for its full fail-closed boundary.
#
# Each *_READONLY_DATABASE_URL value must be a SELECT-only role's
# postgres:// or postgresql:// URL (verified live by verifyReadOnlyRole --
# superuser, any write grant, any grant outside the required table set, or
# any role membership is rejected). The connection additionally requires
# certificate-validated TLS (ssl: 'verify-full', enforced in code
# regardless of what the URL says).
#
# Must include a hostname, a username, and a database name in its path.
# Must NOT include a query string or a fragment -- resolveRemoteUrl
# rejects both outright, even ?sslmode=require, which some providers'
# dashboards include by default in a copy-paste connection string. Strip
# any "?..." or "#..." suffix before pasting the value here; TLS and
# every other connection option this tool relies on are always forced in
# code, never read from the URL.
OZI79_STAGING_READONLY_DATABASE_URL=
OZI79_PRODUCTION_READONLY_DATABASE_URL=

# Each *_EXPECTED_IDENTITY value is a SEPARATE, independently-set
# safeguard against the corresponding *_READONLY_DATABASE_URL above being
# swapped or misconfigured (e.g. staging's variable accidentally pointed
# at the production host). Must equal exactly
# "<username>@<hostname>:<port>/<database>" -- the resolved connection's
# username INCLUDED, not just describeRemoteTarget's safe display form
# (host:port/database only). Named "*_IDENTITY", not "*_DESCRIPTOR": the
# required value is username-inclusive, unlike describeRemoteTarget's
# safe printable descriptor. This is deliberate: some real provider URL
# shapes carry environment identity in the username rather than the
# host. For example, Supabase's connection pooler shares one
# host:port/database across every project in a region --
# "postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# -- and only the username ("postgres.[project-ref]") distinguishes one
# project from another. A value written as just "host:port/database"
# would silently accept a swap between two projects sharing that pooler.
# Example: "postgres.my-staging-ref@aws-0-eu-central-1.pooler.supabase.com:6543/postgres".
# `plan` refuses to connect if this is unset or does not match.
#
# A non-secret SHA-256 fingerprint of this same username-inclusive
# identity (never the raw identity itself) is what the `plan` command
# persists on the produced ExplainPreflightArtifactV2 as
# target.verifiedIdentityFingerprint, and prints in its terminal summary
# -- so a later approval-compatibility check can prove which underlying
# database instance an artifact was actually reviewed against, not just
# that its environment/descriptor matched (which the Supabase pooler
# example above shows is not sufficient on its own).
#
# MUST be sourced independently from authoritative environment/provider
# metadata (the hosting provider's own record of that environment, or a
# value an operator transcribes from it) -- NEVER generated, derived, or
# copied from the *_READONLY_DATABASE_URL above. Deriving one from the
# other makes the safeguard tautological: a swapped or mistyped
# credential would silently satisfy an expectation computed from that
# same mistake instead of catching it.
OZI79_STAGING_EXPECTED_IDENTITY=
OZI79_PRODUCTION_EXPECTED_IDENTITY=
